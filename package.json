{
  "name": "weekly-report-platform",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "node src/index.js",
    "dev": "concurrently -n server,client -c blue,green \"npm:start\" \"npm:client:dev\"",
    "client:dev": "npm --prefix client run dev",
    "client:build": "npm --prefix client run build",
    "build": "npm --prefix client run build",
    "setup": "npm install && npm --prefix client install --legacy-peer-deps --no-audit --no-fund"
  },
  "dependencies": {
    "better-sqlite3": "^11.3.0",
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "playwright": "^1.47.0",
    "ws": "^8.18.0",
    "y-websocket": "^1.5.4",
    "yjs": "^13.6.18"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
